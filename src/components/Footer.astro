---
const cols = [
  {
    head: 'Stages',
    links: [
      ['POST · host lock', '#post'],
      ['DETECT · volumes', '#detect'],
      ['PARTITION · ESP', '#partition'],
      ['WRITE · direct I/O', '#write'],
      ['VERIFY · hashes', '#verify'],
    ],
  },
  {
    head: 'Docs',
    links: [
      ['UEFI quickstart', '#'],
      ['ESP partitioning', '#'],
      ['Driver compatibility', '#'],
      ['Security audits', '#'],
    ],
  },
  {
    head: 'Release',
    links: [
      ['REV 2 release notes', '#'],
      ['PGP signature', '#'],
      ['Source code', '#'],
      ['Licenses', '#'],
    ],
  },
];
---

<footer class="bg-background">
  <div class="max-w-[1280px] mx-auto px-4 sm:px-6 pt-16 pb-10">
    <div class="grid grid-cols-2 md:grid-cols-12 gap-x-6 gap-y-10">
      <div class="col-span-2 md:col-span-3">
        <p class="flex items-center gap-2 font-semibold tracking-tight">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="4" stroke="currentColor" stroke-width="1.5" />
            <path d="M7 12H17M12 7V17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
            <circle cx="12" cy="12" r="2.5" fill="currentColor" />
          </svg>
          <span>L155A</span>
        </p>
        <p class="mt-2 text-[13px] leading-relaxed text-foreground-muted max-w-[22rem]">
          Boot media writer for Windows. Locks the host, builds the ESP, writes direct, verifies inline.
        </p>
      </div>
      {
        cols.map((c) => (
          <nav aria-label={c.head} class="md:col-span-3 font-mono text-[12px]">
            <p class="text-foreground-secondary">{c.head}</p>
            <ul class="mt-3 space-y-2">
              {c.links.map(([label, href]) => (
                <li>
                  <a href={href} class="text-foreground-muted hover:text-foreground hover:underline">
                    {label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>
    <div class="mt-14 pt-5 border-t border-white/[0.07] flex flex-col sm:flex-row gap-3 justify-between font-mono text-[11px] text-foreground-muted">
      <span>(c) 2026 L155A Project</span>
      <span>Exit code 0</span>
    </div>
  </div>
</footer>

---
import { STAGES, SETUP } from '@/data/stages';
---

<header class="sticky top-0 z-40 bg-background/95 border-b border-white/[0.07]" style="backdrop-filter: saturate(1.2) blur(8px);">
  <div class="max-w-[1280px] mx-auto px-4 sm:px-6 h-14 flex items-center gap-6">
    <a href="#top" class="flex items-center gap-2.5 shrink-0 text-foreground" aria-label="L155A home">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <rect x="3" y="3" width="18" height="18" rx="4" stroke="currentColor" stroke-width="1.5" />
        <path d="M7 12H17M12 7V17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        <circle cx="12" cy="12" r="2.5" fill="currentColor" />
      </svg>
      <span class="font-semibold tracking-tight text-[15px]">L155A</span>
      <span class="hidden sm:inline font-mono text-[11px] text-foreground-muted">REV 2</span>
    </a>

    <!-- Desktop: boot stage track -->
    <nav aria-label="Boot stages" class="hidden lg:flex flex-1 items-stretch h-full">
      <ol class="flex flex-1 items-stretch">
        {
          STAGES.map((s) => (
            <li class="flex-1">
              <a href={`#${s.id}`} class="trk relative h-full flex items-center gap-2 px-3 font-mono text-[11px] tracking-wide" data-track={s.id} data-state="wait">
                {s.id === 'post' && (
                  <svg class="trk-icon" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                    <path d="M3.5 1.25h5L10.75 3.5v5L8.5 10.75h-5L1.25 8.5v-5L3.5 1.25Z" stroke="currentColor" stroke-width="1.2" />
                    <path class="trk-core" d="M6 3.5 8.5 6 6 8.5 3.5 6 6 3.5Z" fill="currentColor" />
                  </svg>
                )}
                {s.id === 'detect' && (
                  <svg class="trk-icon" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                    <path d="M1.25 4V1.25H4M8 1.25h2.75V4M10.75 8v2.75H8M4 10.75H1.25V8" stroke="currentColor" stroke-width="1.2" />
                    <path class="trk-core" d="M6 3.6 8.4 6 6 8.4 3.6 6 6 3.6Z" fill="currentColor" />
                  </svg>
                )}
                {s.id === 'partition' && (
                  <svg class="trk-icon" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                    <path class="trk-core" d="M1.25 2h3.8L3.45 10h-2.2V2Z" fill="currentColor" />
                    <path d="M6.6 2h4.15v8H5L6.6 2Z" stroke="currentColor" stroke-width="1.2" />
                  </svg>
                )}
                {s.id === 'write' && (
                  <svg class="trk-icon" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                    <path d="M1.25 2.25 5 6l-3.75 3.75" stroke="currentColor" stroke-width="1.3" />
                    <path class="trk-core" d="M5.5 1.8 10.75 6 5.5 10.2 7.25 6 5.5 1.8Z" fill="currentColor" />
                  </svg>
                )}
                {s.id === 'verify' && (
                  <svg class="trk-icon" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                    <path d="M1.5 1.5h3.3v3.3H1.5zM7.2 1.5h3.3v3.3H7.2zM1.5 7.2h3.3v3.3H1.5z" stroke="currentColor" stroke-width="1.15" />
                    <path class="trk-core" d="M8.85 6.3 11.4 8.85 8.85 11.4 6.3 8.85 8.85 6.3Z" fill="currentColor" />
                  </svg>
                )}
                {s.id === 'boot' && (
                  <svg class="trk-icon" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                    <path class="trk-core" d="M1.75 1.5 10.75 6l-9 4.5L4.1 6 1.75 1.5Z" fill="currentColor" stroke="currentColor" stroke-width="1" />
                  </svg>
                )}
                <span>{s.name}</span>
                <span class="absolute left-3 right-3 bottom-0 h-[2px] bg-white/[0.06] overflow-hidden" aria-hidden="true">
                  <span class="trk-fill" />
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <!-- Mobile / tablet: compact current-stage readout -->
    <div class="lg:hidden flex-1 min-w-0 flex items-center gap-3 font-mono text-[11px]" aria-hidden="true">
      <span class="text-foreground-muted shrink-0" data-compact-idx>0/6</span>
      <span class="text-foreground truncate" data-compact-name>STANDBY</span>
      <span class="relative flex-1 max-w-[120px] h-[2px] bg-white/[0.08] overflow-hidden">
        <span class="trk-fill" data-compact-fill style="background:#F59E0B"></span>
      </span>
    </div>

    <div class="flex items-center gap-2 shrink-0">
      <button
        type="button"
        data-open-palette
        class="hidden sm:inline-flex btn btn-sm btn-ghost text-foreground-secondary"
        aria-label="Open command palette"
      >
        <span>Commands</span>
        <kbd class="key">Ctrl K</kbd>
      </button>
      <button
        type="button"
        data-open-palette
        class="sm:hidden inline-flex items-center justify-center w-9 h-7 border border-white/[0.13] text-foreground-secondary hover:text-foreground hover:border-white/[0.25]"
        aria-label="Open command palette"
      >
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <rect x="0.5" y="0.5" width="13" height="13" stroke="currentColor" />
          <path d="M4 9.5 9.5 4M4 4.5h5.5V10" stroke="currentColor" stroke-width="1.2" />
        </svg>
      </button>
      <a href={SETUP.href} download={SETUP.file} class="btn btn-sm btn-primary">Download</a>
    </div>
  </div>
</header>

<script>
  document.querySelectorAll('[data-open-palette]').forEach((b) =>
    b.addEventListener('click', () => window.dispatchEvent(new CustomEvent('l155a:palette'))),
  );
  if (/Mac|iPhone|iPad/.test(navigator.platform)) {
    document.querySelectorAll('kbd.key').forEach((k) => {
      if (k.textContent === 'Ctrl K') k.textContent = '⌘K';
    });
  }
</script>

---
import { STAGES, token } from '@/data/stages';

interface Props {
  id: string;
  tone?: 'ink' | 'silver';
}

const { id, tone = 'ink' } = Astro.props;
const index = STAGES.findIndex((s) => s.id === id);
const stage = STAGES[index];
const finalInner = token(stage.final).slice(1, -1);
const silver = tone === 'silver';
---

<section
  id={stage.id}
  data-stage={stage.name}
  data-tone={silver ? 'silver' : undefined}
  aria-labelledby={`${stage.id}-h`}
  class:list={['relative', silver ? 'bg-accent text-background' : 'border-t border-white/[0.07]']}
>
  <div class="max-w-[1280px] mx-auto px-4 sm:px-6 py-20 sm:py-28 grid grid-cols-1 lg:grid-cols-12 gap-x-10 gap-y-10">
    <!-- Stage gutter: status line for this stage -->
    <div class="lg:col-span-3">
      <div class="lg:sticky lg:top-24 font-mono">
        <p class="flex items-baseline gap-3 text-[13px]">
          <span data-token data-final={finalInner} class="st st-wait">[ WAIT ]</span>
          <span class:list={['tracking-wide', silver ? 'text-background' : 'text-foreground']}>{stage.name}</span>
        </p>
        <p class:list={['mt-2 text-[11px] leading-relaxed max-w-[16rem]', silver ? 'text-background/70' : 'text-foreground-muted']}>
          {stage.log}
        </p>
        <p class:list={['mt-6 hidden lg:block text-[11px]', silver ? 'text-background/60' : 'text-foreground-muted/80']}>
          stage {index + 1} of {STAGES.length}
        </p>
      </div>
    </div>

    <div class="lg:col-span-9 min-w-0">
      <slot />
    </div>
  </div>
</section>

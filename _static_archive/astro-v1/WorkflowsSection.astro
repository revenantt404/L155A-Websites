---
import WorkflowsIsland from './islands/WorkflowsIsland';
---

<section class="py-28 relative z-10" id="workflows">
  <div class="max-w-[1160px] mx-auto px-6">
    <div class="text-center max-w-[680px] mx-auto mb-16">
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-foreground mb-4">
        Bulletproof workflow pipeline from image to silicon.
      </h2>
      <p class="text-base text-foreground-secondary leading-relaxed">
        Engineered to prevent the edge-cases that cause bricked installations, undetectable volume corruption, and UEFI boot halts.
      </p>
    </div>

    <WorkflowsIsland client:visible />
  </div>
</section>
